{
    "name": "nexph/nexph",
    "version": "0.1.0",
    "type": "app",
    "description": "Nexph adaptive runtime app manifest",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Core\\\\": "bags/runtime/nexph-core/src/",
            "Nexph\\\\": "bags/runtime/nexph-ui/src/"
        }
    },
    "requires": [],
    "scripts": {
        "serve": "php bags/runtime/nexph-core/runtime/server/serve.php",
        "dev": "php nexph dev",
        "test": "php tests/runtime/Loader/LoaderTest.php && php tests/runtime/Loader/SemverTest.php"
    },
    "bin": "nexph",
    "bags": {
        "runtime": "bags/runtime",
        "local": "bags/local",
        "installed": "bags/installed",
        "cache": "bags/cache"
    }
}
