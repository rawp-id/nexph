#!/usr/bin/env php
<?php
/**
 * Nexph CLI - Unified entry point
 *
 * Routes commands to:
 * - Runtime (serve, run, runtime:*, queue:*, schedule:*)
 * - Package Manager (install, remove, update, module:*)
 * - Frontend (build, dev, export, init, test, pages)
 * - Database (migrate:*)
 */

require_once __DIR__ . '/../autoload.php';

use Core\Runtime\CLI\CommandRegistry;

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

// Route to appropriate handler
$exitCode = match (true) {
    // Server commands
    $command === 'serve' => runServe($args),
    $command === 'run' => runFile($args),
    $command === 'stop' => runStop($args),

    // Frontend commands
    in_array($command, ['build', 'dev', 'export', 'init', 'test', 'pages']) => runFrontend($command, $args),

    // Migration commands
    str_starts_with($command, 'migrate:'),
    in_array($command, ['up', 'down', 'rollback', 'reset', 'refresh', 'make:migration']) => runMigration($command, $args),

    // Package manager commands
    in_array($command, ['install', 'remove', 'update', 'restore', 'publish', 'search']) => runRuntime($command, $args),
    str_starts_with($command, 'package:') => runRuntime($command, $args),
    str_starts_with($command, 'module:') => runRuntime($command, $args),

    // Runtime CLI commands (queue:*, runtime:*, schedule:*, help)
    default => runRuntime($command, $args),
};

exit($exitCode);

function runServe(array $args): int
{
    $mode = 'http';
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--mode=')) {
            $mode = substr($arg, 7);
        }
    }

    $script = __DIR__ . '/../runtime/server/serve.php';
    $cmd = PHP_BINARY . ' ' . escapeshellarg($script);
    foreach ($args as $arg) {
        $cmd .= ' ' . escapeshellarg($arg);
    }

    passthru($cmd, $exitCode);
    return $exitCode;
}

function runFile(array $args): int
{
    if (empty($args)) {
        fwrite(STDERR, "Usage: nexph run <file.php> [args...]\n");
        return 1;
    }

    $file = array_shift($args);
    if (!file_exists($file)) {
        fwrite(STDERR, "Error: File not found: {$file}\n");
        return 1;
    }

    // Set argv for the target script
    $GLOBALS['argv'] = array_merge([$file], $args);
    $GLOBALS['argc'] = count($GLOBALS['argv']);

    try {
        require_once $file;
        return 0;
    } catch (\Throwable $e) {
        fwrite(STDERR, "Error: {$e->getMessage()}\n");
        fwrite(STDERR, "  {$e->getFile()}:{$e->getLine()}\n");
        return 1;
    }
}

function runStop(array $args): int
{
    $script = __DIR__ . '/../stop';
    if (!file_exists($script)) {
        $script = __DIR__ . '/../backend-engine/stop';
    }
    $cmd = PHP_BINARY . ' ' . escapeshellarg($script);
    passthru($cmd, $exitCode);
    return $exitCode;
}

function runFrontend(string $command, array $args): int
{
    // TODO: integrate frontend CLI when unified
    fwrite(STDERR, "Frontend command '{$command}' not yet integrated.\n");
    fwrite(STDERR, "Use frontend-engine/bin/nexph {$command} directly.\n");
    return 1;
}

function runMigration(string $command, array $args): int
{
    $script = __DIR__ . '/../nexph';
    if (!file_exists($script)) {
        $script = __DIR__ . '/../backend-engine/nexph';
    }
    $cmd = PHP_BINARY . ' ' . escapeshellarg($script) . ' ' . escapeshellarg($command);
    foreach ($args as $arg) {
        $cmd .= ' ' . escapeshellarg($arg);
    }
    passthru($cmd, $exitCode);
    return $exitCode;
}

function runPackage(string $command, array $args): int
{
    // TODO: implement package manager commands
    fwrite(STDERR, "Package command '{$command}' not yet implemented.\n");
    return 1;
}

function runModule(string $command, array $args): int
{
    // TODO: implement module commands
    fwrite(STDERR, "Module command '{$command}' not yet implemented.\n");
    return 1;
}

function runRuntime(string $command, array $args): int
{
    $registry = new CommandRegistry();
    return $registry->execute($command, $args);
}
